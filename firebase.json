{
  "hosting": {
    "public": "app/dist",
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "osagari-api", "region": "asia-northeast1" }
      },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
