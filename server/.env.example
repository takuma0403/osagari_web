# server が読む環境変数の一覧（値はローカル開発の例）。
# ローカルでは compose.yaml に同じ値を直書きしているので、このファイルをコピーする必要はない。
# 本番の値（Turso のトークンなど）は Secret Manager に置き、ここには書かない。

# libSQL の接続先。ローカル: http://localhost:8081（ホストから） / http://db:8080（compose 内）
# 本番: libsql://<db>.turso.io?authToken=<token>
DATABASE_URL=http://localhost:8081
# migrations ディレクトリの URL
MIGRATIONS_URL=file://migrations
PORT=8080

# Cloud Storage。ローカルは fake-gcs-server（設定するとエミュレータに向く）
STORAGE_EMULATOR_HOST=localhost:4443
# エミュレータを使うときに、署名付きURLに入れるブラウザから届くホスト。未設定なら STORAGE_EMULATOR_HOST と同じ。本番は設定しない
STORAGE_PUBLIC_HOST=localhost:4443
STORAGE_BUCKET_ITEM_IMAGES=item-images
STORAGE_BUCKET_STUDENT_CARDS=student-cards

# メール。ローカルは Mailpit（本番は Gmail SMTP 587 / STARTTLS。AUTHN-7）
SMTP_HOST=localhost
SMTP_PORT=1025
# 差出人。"addr@example.com" または "名前 <addr@example.com>"
SMTP_FROM=お下がりフリマ <noreply@osagari.local>
# 本番は Gmail のアカウントとアプリパスワード（Secret Manager）。空なら認証しない（Mailpit）
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS を必須にするか。本番は true（既定）、Mailpit は false
SMTP_STARTTLS=false

# 管理者の学籍番号（8桁）のカンマ区切り。空なら管理者はいない（ADMIN, ADR 0015）
ADMIN_STUDENT_NUMBERS=

# 内部用エンドポイント（定期処理）の呼び出し元の確認（JOBS-1, ADR 0027）。どちらか一方だけを設定する
# 本番：Cloud Scheduler のジョブに設定した audience（呼び出す URL）と、Cloud Scheduler のサービスアカウントのメールアドレス
JOBS_OIDC_AUDIENCE=
JOBS_SERVICE_ACCOUNT_EMAIL=
# ローカル：Authorization: Bearer で送る共有シークレット（本番では使わない）
JOBS_LOCAL_SECRET=local-jobs-secret
