# server が読む環境変数の一覧（値はローカル開発の例）。
# ローカルでは compose.yaml に同じ値を直書きしているので、このファイルをコピーする必要はない。
# 本番の値（Turso のトークンなど）は Secret Manager に置き、ここには書かない。

# libSQL の接続先。ローカル: http://localhost:8081（ホストから） / http://db:8080（compose 内）
# 本番: libsql://<db>.turso.io?authToken=<token>
DATABASE_URL=http://localhost:8081
# migrations ディレクトリの URL
MIGRATIONS_URL=file://migrations
PORT=8080

# Cloud Storage。ローカルは fake-gcs-server（設定するとエミュレータに向く）
STORAGE_EMULATOR_HOST=localhost:4443
STORAGE_BUCKET_ITEM_IMAGES=item-images
STORAGE_BUCKET_STUDENT_CARDS=student-cards

# メール。ローカルは Mailpit（本番は Gmail SMTP 587 / STARTTLS）
SMTP_HOST=localhost
SMTP_PORT=1025
